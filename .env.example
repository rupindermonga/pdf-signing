# CertaDocs Configuration
# NODE_ENV=development shows OTP codes on screen when email is not configured
# NODE_ENV=production (or unset) NEVER exposes OTP codes — email MUST work
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# SMTP Email (optional - signing links shown in dashboard if not configured)
# Works with ANY email provider that supports SMTP:
#
#   Gmail:       SMTP_HOST=smtp.gmail.com       SMTP_PORT=587
#                (use App Password: https://myaccount.google.com/apppasswords)
#   Outlook:     SMTP_HOST=smtp.office365.com   SMTP_PORT=587
#   Yahoo:       SMTP_HOST=smtp.mail.yahoo.com  SMTP_PORT=587
#   Zoho:        SMTP_HOST=smtp.zoho.com        SMTP_PORT=587
#   SendGrid:    SMTP_HOST=smtp.sendgrid.net    SMTP_PORT=587
#   AWS SES:     SMTP_HOST=email-smtp.us-east-1.amazonaws.com SMTP_PORT=587
#   Custom:      Any SMTP server works
#
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_NAME=CertaDocs
FROM_EMAIL=

# Session secret — REQUIRED.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# P12 certificate passphrase — REQUIRED.
# `node generate-cert.js` uses this when creating cert/certadocs.p12 — change it
# (and regenerate the cert) before production.
P12_PASSPHRASE=

# ID-verification at-rest encryption key — REQUIRED in production.
# AES-256-GCM key material. Generate with: openssl rand -base64 32
# Rotating this key makes all previously-stored ID images unreadable by design.
ID_VERIF_KEY=

# TOTP secret encryption key — REQUIRED in production.
# Generate with: openssl rand -base64 32
# Rotating this key invalidates all enrolled TOTP devices; users must re-enroll.
TOTP_KEY=

# Stripe webhook endpoint secret — REQUIRED if using Stripe payments.
# Create at: https://dashboard.stripe.com/webhooks → copy "Signing secret" (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Razorpay webhook secret — REQUIRED if using Razorpay payments.
RAZORPAY_WEBHOOK_SECRET=
